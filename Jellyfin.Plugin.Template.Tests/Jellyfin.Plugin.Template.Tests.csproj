<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Follows the plugin, which reads it from Directory.Build.props, so a test never runs against a framework the plugin is not built for. -->
    <TargetFramework>$(JellyfinTargetFramework)</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Template.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Every analyzer setting below is the plugin's, with no difference. GenerateDocumentationFile stays on: with it off the StyleCop pass reports SA0001 and stops analysing comments at all, which would be a quieter gate rather than a cheaper one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The plugin excludes the runtime assets of these two, because a server
      supplies them and a package that carried its own copy would load twice.
      Nothing supplies them to a test host, so touching any plugin type throws
      FileNotFoundException on MediaBrowser.Common before a test body runs. They
      are referenced here with their assets kept, at the version the declared
      server line names, so the test runs against the same assemblies the plugin
      was compiled against.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackageVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Jellyfin.Plugin.Template/Jellyfin.Plugin.Template.csproj" />
  </ItemGroup>

</Project>
